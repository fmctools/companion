    "Remove custom faces" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убрать свои циферблаты"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибрати власні циферблати"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar esferas personalizadas"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कस्टम फ़ेस हटाएँ"
          }
        }
      }
    },
    "Keeps only the built-in faces the watch last reported and shows the first one. Your data stays. Not yet tried on a stuck watch." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет только встроенные циферблаты из последнего списка часов и включает первый. Данные остаются. На зависших часах ещё не проверено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишає лише вбудовані циферблати з останнього списку годинника й вмикає перший. Дані лишаються. На завислому годиннику ще не перевірено."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja solo las esferas integradas que el reloj indicó la última vez y muestra la primera. Tus datos se mantienen. Aún no probado en un reloj bloqueado."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ वे बिल्ट-इन फ़ेस रखता है जो घड़ी ने पिछली बार बताए थे, और पहला दिखाता है। आपका डेटा रहता है। अटकी हुई घड़ी पर अभी आज़माया नहीं गया।"
          }
        }
      }
    },
    "Erases everything on the watch and restarts it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стирает всё на часах и перезагружает их."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стирає все на годиннику й перезавантажує його."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra todo lo que hay en el reloj y lo reinicia."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घड़ी पर सब कुछ मिटाकर उसे रीस्टार्ट करता है।"
          }
        }
      }
    },
    "Keep this screen open and the phone next to the watch." : {
