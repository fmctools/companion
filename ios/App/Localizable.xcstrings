    "Sent with every request %@ makes to %@. They stay on this iPhone, in the Keychain, and never go to the watch." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляются с каждым запросом %1$@ к %2$@. Хранятся на этом iPhone в Связке ключей и никогда не уходят на часы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилаються з кожним запитом %1$@ до %2$@. Зберігаються на цьому iPhone у Зв'язці ключів і ніколи не йдуть на годинник."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envían con cada solicitud que %1$@ hace a %2$@. Se quedan en este iPhone, en el Llavero, y nunca van al reloj."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ के %2$@ को भेजे हर अनुरोध के साथ जाते हैं। ये इसी iPhone के Keychain में रहते हैं और कभी घड़ी पर नहीं जाते।"
