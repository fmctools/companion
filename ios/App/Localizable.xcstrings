{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    " → widget" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " → виджет"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " → віджет"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " → widget"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " → विजेट"
          }
        }
      }
    },
    "%@ asked the phone to fetch these on its own, for its widget or page on the watch. They run while the phone is connected to the watch." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ попросило телефон загружать это само, для своего виджета или страницы на часах. Работает, пока телефон подключён к часам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ попросив телефон завантажувати це сам, для свого віджета або сторінки на годиннику. Працює, поки телефон підключений до годинника."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pidió al teléfono que obtenga esto por su cuenta, para su widget o su página en el reloj. Funciona mientras el teléfono está conectado al reloj."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने फ़ोन से कहा है कि वह इन्हें खुद लाए, घड़ी पर इसके विजेट या पेज के लिए। ये तब चलते हैं जब फ़ोन घड़ी से जुड़ा हो।"
          }
        }
      }
    },
    "%@ asks again the next time it needs something." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ спросит снова, когда что-то понадобится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ запитає знову, коли щось знадобиться."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ volverá a preguntar la próxima vez que necesite algo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अगली बार कुछ चाहिए होने पर फिर से पूछेगा।"
          }
        }
      }
    },
    "%@ hasn't asked for anything on your phone." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ пока ничего не запрашивало на телефоне."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ поки нічого не запитував на телефоні."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha pedido nada en tu teléfono."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने आपके फ़ोन पर अभी तक कुछ नहीं माँगा है।"
          }
        }
      }
    },
    "%@ is running on the watch. If it is a page next to the watch face, remove the page first: on the watch, long press %@ in Apps → Remove page. Else go back to the watch face. Then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ запущено на часах. Если это страница рядом с циферблатом, сначала уберите её: на часах удерживайте %@ в «Приложениях» → «Удалить страницу». Иначе вернитесь на циферблат. Потом попробуйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ запущено на годиннику. Якщо це сторінка поруч із циферблатом, спершу приберіть її: на годиннику утримуйте %@ у «Застосунках» → «Видалити сторінку». Інакше поверніться на циферблат. Потім спробуйте знову."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está abierta en el reloj. Si es una página junto a la esfera, quítala primero: en el reloj, mantén pulsada %@ en Apps → Quitar página. Si no, vuelve a la esfera. Luego inténtalo de nuevo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ घड़ी पर चल रहा है। अगर यह वॉच फ़ेस के पास का पेज है, तो पहले उसे हटाएँ: घड़ी पर Apps में %@ को दबाकर रखें → पेज हटाएँ। नहीं तो वॉच फ़ेस पर लौटें। फिर से कोशिश करें।"
          }
        }
      }
    },
    "%@ on your watch is looking for this phone." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ на часах ищет этот телефон."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ на годиннику шукає цей телефон."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en tu reloj está buscando este teléfono."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी घड़ी पर %@ इस फ़ोन को ढूँढ रहा है।"
          }
        }
      }
    },
    "%@ or the Apps menu is open on the watch. Go back to the watch face, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На часах открыто %@ или меню приложений. Вернитесь на циферблат и попробуйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На годиннику відкрито %@ або меню застосунків. Поверніться на циферблат і спробуйте знову."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ o el menú de apps está abierto en el reloj. Vuelve a la esfera e inténtalo de nuevo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घड़ी पर %@ या Apps मेन्यू खुला है। वॉच फ़ेस पर लौटें, फिर से कोशिश करें।"
          }
        }
      }
    },
