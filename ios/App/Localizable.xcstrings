    "It goes from the watch. To get it back, install it again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он пропадёт с часов. Чтобы вернуть, установите его снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він зникне з годинника. Щоб повернути, встановіть його знову."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitará del reloj. Para recuperarla, instálala de nuevo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह घड़ी से हट जाएगा। वापस पाने के लिए इसे फिर से इंस्टॉल करें।"
          }
        }
      }
    },
    "Its data on the watch goes too." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его данные на часах тоже удалятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його дані на годиннику теж видаляться."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus datos en el reloj también se eliminan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घड़ी पर इसका डेटा भी हट जाएगा।"
          }
        }
      }
    },
    "Keep the watch connected in Nothing X. The app only reads from it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите часы подключёнными в Nothing X. Приложение только читает с них."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
